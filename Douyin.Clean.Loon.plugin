#!name = 抖音去广告与 TikTok 风格净化
#!desc = 路径级拦截开屏与广告下发，过滤信息流广告；首页默认仅保留关注/推荐频道，并清理侧栏运营入口和动态底栏皮肤。
#!author = Codex
#!homepage = https://github.com/shengrui123/Loon-YouTube-Plugin
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/TikTok.png
#!loon_version = 3.5.1(983)
#!system = iOS,iPadOS
#!tag = 去广告,应用净化,抖音
#!type = normal

# 发布版本：1.0.1；2026-09-12
# 修正：移除可能误伤评论等正常业务的共享 IP/6443 规则；首页净化改用原生 JSON Rewrite。
# 采用 Loon Script V2 / Rewrite V2 语法。
# 默认界面：顶部仅保留“关注、推荐”，关闭运营皮肤，清理侧栏常用小程序和常访问的人。
# 网络规则无法移除客户端写死的所有控件；抖音接口改版后可能需要更新匹配范围。

[Argument]
block_splash = switch,true,tag=屏蔽开屏广告,desc=仅拦截已知广告接口，不封禁抖音共享服务器 IP
feed_ads = switch,true,tag=过滤信息流广告,desc=仅删除带明确广告标识的推荐、关注、搜索等列表项
minimal_tabs = switch,true,tag=精简顶部频道,desc=仅保留关注和推荐，接近 TikTok 首页
keep_live = switch,false,tag=保留直播频道,desc=精简顶部频道时额外保留直播
clean_sidebar = switch,true,tag=净化侧栏,desc=移除常用小程序、常访问的人及首页常用功能模块
clean_tabbar = switch,true,tag=净化底栏样式,desc=关闭服务端动态皮肤并恢复客户端基础底栏

[Rewrite]
# 开屏及广告配置下发：路径级拦截，不屏蔽共享 IP 或整个 API 域名。
request if ${block_splash} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/(?:api\/ad|aweme\/v\d+\/splash)\//i then reject_dict(200)
request if ${block_splash} == true && ${url} ~= /^https:\/\/zlink\.ugsdk\.cn\/ad\//i then reject_dict(200)

# 首页顶部频道：Loon 原生 Rewrite 可与其他响应规则依次执行，避免 Response Script 首条命中限制。
response if ${minimal_tabs} == true && ${keep_live} == false && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/homepage\/render\//i && ${response.status} == 200 then response.json.jq(`if (.data.tab_list? | type) == "array" then if ([.data.tab_list[]? | (.tab_id? // .channel_id? // .channelID?)] | any(. != null)) then .data.tab_list |= map(select((.tab_id // .channel_id // .channelID // "") | IN("homepage_follow", "homepage_hot_container"))) else .data.tab_list[]?.extra.tab_list? |= map(select((.tab_id // .channel_id // .channelID // "") | IN("homepage_follow", "homepage_hot_container"))) | .data.tab_list |= map(select((.extra.tab_list? | type) != "array" or (.extra.tab_list | length > 0))) end else . end`)
response if ${minimal_tabs} == true && ${keep_live} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/homepage\/render\//i && ${response.status} == 200 then response.json.jq(`if (.data.tab_list? | type) == "array" then if ([.data.tab_list[]? | (.tab_id? // .channel_id? // .channelID?)] | any(. != null)) then .data.tab_list |= map(select((.tab_id // .channel_id // .channelID // "") | IN("homepage_tablive", "homepage_follow", "homepage_hot_container"))) else .data.tab_list[]?.extra.tab_list? |= map(select((.tab_id // .channel_id // .channelID // "") | IN("homepage_tablive", "homepage_follow", "homepage_hot_container"))) | .data.tab_list |= map(select((.extra.tab_list? | type) != "array" or (.extra.tab_list | length > 0))) end else . end`)

# 侧栏常用功能、常用小程序和常访问的人。
response if ${clean_sidebar} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/homepage\/render\//i && ${response.status} == 200 then response.json.jq(`.data.tab_list[]?.extra.side_bar.modules? |= map(if (.items? | type) == "array" then .items |= map(select(.data.first_page_module.module_title? != "常用功能")) else . end | select(.module_title? != "常用功能") | select((.items? | type) != "array" or (.items | length > 0)))`)
response if ${clean_sidebar} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/homepage\/sidebar_data\//i && ${response.status} == 200 then response.json.delete(["data_map.recently_apps", "data_map.recently_users"])

# 删除服务端底栏切换，关闭运营皮肤与动态加号。
response if ${clean_tabbar} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/homepage\/render\//i && ${response.status} == 200 then response.json.delete("data.tab_config")
response if ${clean_tabbar} == true && ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/tfe\/api\/request_combine\/v1\//i && ${response.status} == 200 then response.json.jq(`if (.data["/service/settings/v3/"].body.data.settings? | type) == "object" then .data["/service/settings/v3/"].body.data.settings.homepage_two_session_tab_skin_2025 = false | .data["/service/settings/v3/"].body.data.settings.homepage_tab_skin_enable = false | del(.data["/service/settings/v3/"].body.data.settings.tab_bar_background_use_server_time, .data["/service/settings/v3/"].body.data.settings.dynamic_plus_icon_config) else . end`)

[Script]
response if ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api\d*(?:-[a-z0-9]+)*\.amemv\.com)\/aweme\/v\d+\/(?:feed|follow\/feed|nearby\/feed|search\/item|general\/search\/single)\//i && ${response.status} == 200 then script("https://raw.githubusercontent.com/shengrui123/Loon-YouTube-Plugin/main/Douyin.Clean.Loon.js?v=20260912-2", {${feed_ads}}) with enable=${feed_ads}, requires_body=true, timeout=10, tag="抖音信息流广告过滤"

[Mitm]
hostname = aweme.snssdk.com,*.amemv.com,zlink.ugsdk.cn
